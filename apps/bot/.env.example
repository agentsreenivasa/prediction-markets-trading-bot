# Polymarket BTC Trading Bot Configuration
# Copy to .env and fill in values

# === Trading Mode ===
PAPER_TRADING=true  # Set to false ONLY after paper trading validation

# === Polymarket Credentials ===
# Generate via py-clob-client: client.create_or_derive_api_creds()
POLY_PRIVATE_KEY=           # Polygon wallet private key (0x...)
POLY_FUNDER_ADDRESS=        # Polygon address holding USDC.e funds
POLY_API_KEY=               # CLOB API key (UUID)
POLY_API_SECRET=            # CLOB API secret (Base64)
POLY_API_PASSPHRASE=        # CLOB API passphrase

# === Risk Management ===
MAX_DAILY_LOSS_PCT=0.05     # 5% daily loss circuit breaker
MAX_RISK_PER_TRADE=0.02     # 2% max risk per trade
KELLY_FRACTION=0.25         # Quarter Kelly criterion
MIN_SIGNAL_THRESHOLD=0.55   # Minimum signal score to trade
MAX_CONCURRENT_EXPOSURE=0.10 # 10% max total exposure
MAX_CONSECUTIVE_LOSSES=5    # Stop after 5 consecutive losses
MAX_HOURLY_LOSS_PCT=0.02    # 2% hourly loss pause

# === Execution ===
MAX_EXECUTION_LATENCY_MS=300 # Skip trades if latency > 300ms
HEARTBEAT_INTERVAL_S=5       # Polymarket heartbeat interval
MIN_ORDER_SIZE_USD=1.0       # Minimum order size
DEFAULT_INTERVAL_MINUTES=5   # Market interval (5 or 15)

# === Database ===
DATABASE_URL=sqlite+aiosqlite:///trades.db  # Use asyncpg://... for PostgreSQL
INITIAL_BALANCE=10000.0     # Starting paper trading balance
